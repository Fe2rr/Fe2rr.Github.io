# Set these Environment Variables in Deno Deploy (Project Settings -> Environment Variables)
# Note: Deno Deploy automatically connects Deno.openKv() with zero extra configuration.

ALLOWED_ORIGINS=https://fe2rr.github.io,https://napl-catalog.pages.dev,https://napl-admin.pages.dev,http://localhost:3000,http://127.0.0.1:3000
REPORTER_HASH_SECRET=change-this-to-your-supabase-secret-for-reporter-continuity
GITHUB_DATA_REPO=Fe2rr/NAPL-Data
DISCORD_WEBHOOK_URL=

# Optional overrides for local Deno CLI testing:
PORT=8787
HOST=0.0.0.0
DENO_KV_PATH=
DEVICES_JSON_PATH=
