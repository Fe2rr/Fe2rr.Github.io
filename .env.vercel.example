# Vercel server-side only. Never prefix these with VITE_ or NEXT_PUBLIC_.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
REPORTER_HASH_SECRET=copy-the-current-Supabase-server-key-to-preserve-link-report-hashes
GITHUB_TOKEN=token-with-read-write-access-to-Fe2rr/NAPL-Data
CATALOG_DATA_GITHUB_TOKEN=token-with-contents-write-access-to-Fe2rr/NAPL-Data
GH_ACTIONS_TOKEN=token-with-actions-write-access-to-Fe2rr/Napl-prueba
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
ALLOWED_ORIGINS=https://fe2rr.github.io,https://napl-admin.pages.dev,https://YOUR-VERCEL-DOMAIN.vercel.app
NAPL_DATA_REPO=Fe2rr/NAPL-Data
NAPL_SYNC_WORKFLOW=sync-catalog.yml
